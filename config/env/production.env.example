# Vercel Environment: Production (main). Preview에 적용하지 않습니다.
APP_ENV=production
API_INTERNAL_URL=https://api.newdok.store
NEXT_PUBLIC_SITE_URL=https://newdok.vercel.app
# 검색 공개는 출시 시 별도로 활성화합니다.
ALLOW_INDEXING=false

# 운영 API 서버에서 사용하는 Kakao 앱의 웹 REST 키
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://newdok.vercel.app/login

# 기존 Vercel Production에서 확인한 웹 Services ID입니다.
# 운영 API의 APPLE_WEB_CLIENT_ID도 이 값과 같아야 합니다.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.newdok.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://newdok.vercel.app/login
