# Vercel Environment: Preview (develop). 실제 REST 키를 Git에 커밋하지 않습니다.
APP_ENV=development
API_INTERNAL_URL=https://api-dev.newdok.store
NEXT_PUBLIC_SITE_URL=https://newdok-dev.vercel.app
ALLOW_INDEXING=false

# 개발 API 서버에서 사용하는 Kakao 앱의 웹 REST 키
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 개발 API의 APPLE_WEB_CLIENT_ID와 동일한 Services ID
NEXT_PUBLIC_APPLE_CLIENT_ID=com.newdok.dev.web
# Kakao·Apple 콘솔에 https://newdok-dev.vercel.app/login을 등록합니다.
# 콜백은 실제 접속 주소에서 만들므로 별도 redirect env를 설정하지 않습니다.
