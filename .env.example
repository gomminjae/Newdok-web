# 로컬 개발용. .env.local에 복사한 뒤 개발용 웹 REST 키를 입력합니다.
# Vercel은 config/env/preview.env.example, production.env.example을 참고해
# Preview와 Production 범위에 각각 설정합니다. .env.development는 Preview 설정이 아닙니다.
APP_ENV=development
API_INTERNAL_URL=https://api-dev.newdok.store

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_INDEXING=false

# Kakao Developers > 앱 > 플랫폼 키 > REST API 키
# Native/JavaScript 키가 아닌, 해당 API 서버와 같은 Kakao 앱의 웹 REST 키입니다.
# Redirect URI에 각 환경 주소의 /login을 등록합니다.
# 토큰 교환과 클라이언트 시크릿은 백엔드에서 관리합니다.
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/login

# 웹 Services ID입니다. iOS Bundle ID가 아닙니다.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.newdok.dev.web
# Apple은 HTTPS가 필요하므로 공개 HTTPS 테스트 웹에서 검증합니다.
# 해당 주소를 Apple Developer의 도메인·Return URL에도 등록해야 합니다.
NEXT_PUBLIC_APPLE_REDIRECT_URI=
