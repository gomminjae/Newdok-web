# 브라우저 요청과 서버 요청이 공통으로 사용하는 Newdok 테스트 API
API_INTERNAL_URL=https://api-dev.newdok.store

# Kakao Developers > 앱 > 플랫폼 키 > REST API 키
# Redirect URI에는 각 실행 도메인의 /login을 등록합니다.
# 예: http://localhost:3000/login, https://www.example.com/login
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# REST API 키의 클라이언트 시크릿 (활성화 상태라면 필수)
KAKAO_CLIENT_SECRET=

# Apple Developer > Certificates, Identifiers & Profiles > Services IDs
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Apple Developer에 등록한 HTTPS Return URL (localhost 및 IP 주소 사용 불가)
NEXT_PUBLIC_APPLE_REDIRECT_URI=
